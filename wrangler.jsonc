{
  // Cloudflare Workers static-assets site — diyasubedi.com.np
  // There is no build step: every file in this directory (including all
  // poem-*.html pages) is served directly as a static asset.
  "name": "portfolio",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
